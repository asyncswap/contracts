# Foundry build artifacts
out/
cache/

# forge coverage reports
lcov.info
coverage/

# Local environment and deployment secrets
.env
.env.*
!.env.deploy.example

# Local deployment output. The per-chain registry deployments/<chainId>/<chainId>.json
# is tracked: it is the record of what is live and what downstream (indexer,
# api, app) generate their addresses from. Receipts and verify inputs stay local.
broadcast/
deployments/*
!deployments/*/
deployments/*/*
!deployments/*/[0-9]*.json

# Soldeer dependencies are managed by the lockfile; required git submodules are tracked separately
dependencies/forge-std-1.16.0/
dependencies/solmate-6.8.0/
dependencies/uniswap-v4-core-4/

# Bun/npm dependencies for script/*.ts helpers
node_modules/

# Formal Mind's local state (the plan, runs, ledger): kept out of the repository
/.formal/
.solidity-auditor/

# Local dev stack (script/local/up.sh): anvil state and the app env it prints
/.local/
deployments/31337/

# formalmind
/formal/
/formalmind.toml
audit/formal-mind.audit.json

# Local tool output and leftovers
/.claude/
/.playwright-mcp/
/fizz_data/
/forge-results.json
/.gas-snapshot
/deployments2/
/x-ray/

# Old Vocs docs scaffold; the docs site lives in site/
/docs/.gitignore
/docs/bun.lock
/docs/package.json
/docs/src/
/docs/vocs.config.ts
/docs/vocs.sidebar.ts

# Audit: only the current scope and the index are tracked; earlier reports are at 2739d6c/audit/
/audit/*
!/audit/README.md
!/audit/AUDIT_SCOPE_11_05_26.md

# Isolated Solar compiler validation artifacts
out-solar/
cache-solar/

# Isolated Solar adversarial validation artifacts
out-solar-adversarial/
cache-solar-adversarial/

# Isolated LP validation build
out-lp-validation/
cache-lp-validation/

# Matching disk metadata for Solar coverage
out-solar-coverage/
cache-solar-coverage/

# Generated source-only coverage report
/coverage/

# Python validation helpers
__pycache__/

# benchmark
/benchmarks/
